NODE_ENV=production
PORT=10000
TRUST_PROXY=1
DATA_DIR=/var/data
DB_FILE=/var/data/come_sayula.db
BACKUP_RETENTION_COUNT=7
DISK_CAPACITY_GB=1
UPLOADS_DIR=/var/data/uploads
JWT_SECRET=replace-with-at-least-48-random-bytes
ADMIN_EMAIL=replace-with-admin-email
ADMIN_PASSWORD=replace-with-a-new-strong-password
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5-mini
SUPPORT_EMAIL=soporte@example.com
SUPPORT_PHONE=replace-with-support-phone
APP_BASE_URL=https://come-sayula.onrender.com
SENDGRID_API_KEY=replace-with-sendgrid-api-key
SENDGRID_FROM_EMAIL=replace-with-verified-sender-email
SENDGRID_FROM_NAME=COME SAYULA
ACCOUNT_MESSAGE_PROVIDER_ENABLED=0
LEGAL_DOCUMENTS_APPROVED=0
PAYMENT_PROVIDER_ENABLED=0
MERCADOPAGO_MODE=test
MERCADOPAGO_TEST_PUBLIC_KEY=replace-with-test-public-key
MERCADOPAGO_TEST_ACCESS_TOKEN=replace-with-test-access-token
MERCADOPAGO_ACCESS_TOKEN=replace-only-when-production-is-approved
MERCADOPAGO_WEBHOOK_SECRET=replace-after-configuring-webhooks
VAPID_PUBLIC_KEY=replace-with-public-vapid-key
VAPID_PRIVATE_KEY=replace-with-private-vapid-key

